# PostgreSQL connection string for local or hosted PostgreSQL (e.g. Neon).
# Never commit real credentials. Copy this file to .env.local and fill in private values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/phantom_trace?sslmode=require"
AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"

# Hosted volunteer pilot requirements (leave unset for local-only development).
APP_BASE_URL="https://your-approved-domain.example"

# Shared Redis-compatible HTTPS REST service used for rate-limit counters only.
RATE_LIMIT_BACKEND="redis"
RATE_LIMIT_URL="https://your-redis-rest-endpoint.example"
RATE_LIMIT_TOKEN="REPLACE_WITH_REDIS_REST_TOKEN"

# Coturn REST shared-secret authentication. Never expose the shared secret to clients.
TURN_URL="turn:turn.your-approved-domain.example:3478?transport=udp,turns:turn.your-approved-domain.example:5349?transport=tcp"
TURN_SHARED_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
